# ==============================================================================
# Naratifnews (AdaFakta) - Environment Variables Configuration Template
# Copy this file to .env.local and fill in the values before running the app.
# NEVER commit your actual .env.local file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# Connection string from your Neon console (use pooled connection string)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Secret key used by jose to encrypt/sign stateless admin session JWT cookies
SESSION_SECRET="generate-a-strong-random-32-byte-secret-here"

# Password required to log into the editorial admin panel (/admin/login)
ADMIN_PASSWORD="change-this-to-a-secure-admin-password"

# Bearer token used to authenticate automated cron routes (/api/cron/*)
CRON_SECRET="generate-a-strong-random-cron-secret-token"

# Canonical public site URL (used in OpenGraph, sitemaps, RSS, and schema metadata)
NEXT_PUBLIC_SITE_URL="https://naratifnews.vercel.app"

# API key for the incoming news ingestion endpoint (/api/incoming-news)
JURNALIS_API_KEY="generate-a-strong-api-key-for-news-ingestion"

# ------------------------------------------------------------------------------
# 3. AI PROVIDER GATEWAYS (Multi-Model Support)
# ------------------------------------------------------------------------------
# Google Gemini (Google AI Studio) - Primary news drafting engine
GEMINI_API_KEY=""
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
GEMINI_MODEL="gemini-2.5-flash"

# Groq Cloud (High-speed open-source models)
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="openai/gpt-oss-120b"

# 9Router / OpenAI-Compatible Multi-Model Proxy (Claude, DeepSeek, etc.)
NINEROUTER_API_KEY=""
NINEROUTER_BASE_URL="https://your-9router-endpoint/v1"
NINEROUTER_MODEL="ag/claude-opus-4-6-thinking"

# Fallback local 9Router configurations (optional)
LOCAL_9ROUTER_KEY=""
LOCAL_9ROUTER_BASE_URL="http://localhost:20128/v1"
LOCAL_9ROUTER_MODEL="elfgw/elf/deepseek-v4-flash"
MODELROUTER_MODEL="muse-spark-1.3-contributor"

# ------------------------------------------------------------------------------
# 4. TELEGRAM NEWSROOM BOT (Notifications & Remote Commands)
# ------------------------------------------------------------------------------
# Telegram Bot Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=""

# Telegram user/chat ID of the chief editor for receiving publication alerts
TELEGRAM_ADMIN_CHAT_ID=""

# Allowed chat ID whitelist for executing bot commands (optional)
TELEGRAM_ALLOWED_CHAT_ID=""

# ------------------------------------------------------------------------------
# 5. SEARCH ENGINE INSTANT INDEXING (SEO)
# ------------------------------------------------------------------------------
# IndexNow API key for instant Bing, Yandex, and Seznam indexing
INDEXNOW_KEY=""

# Google Service Account credentials for Google Indexing API
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# ------------------------------------------------------------------------------
# 6. MEDIA CDN (ImgBB)
# ------------------------------------------------------------------------------
# ImgBB API v1 key for uploading scraped and compressed cover photos
IMGBB_API_KEY=""

# ------------------------------------------------------------------------------
# 7. INFRASTRUCTURE & MONITORING (Optional)
# ------------------------------------------------------------------------------
# Vercel REST API token and project IDs for displaying build status badge
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_SLUG=""

# Instabox VPS API credentials for microservices monitoring & auto keepalive
INSTABOX_API_KEY=""
INSTABOX_API_URL="https://api.instabox.sh"
INSTABOX_MACHINE_ID=""

# cron-job.org API key for external cron monitoring (optional)
CRONJOB_API_KEY=""

# ------------------------------------------------------------------------------
# 8. VIRTUAL AI OFFICE TELEMETRY (3D Kantor AI Webhook)
# ------------------------------------------------------------------------------
# Webhook URL for external 3D virtual office diorama animation triggers
KANTORAI_URL=""
KANTORAI_WEBHOOK_SECRET=""

